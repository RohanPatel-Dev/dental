# Every value is required: docker-compose refuses to start without them rather than defaulting to
# something guessable.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_PASSWORD=

# At least 32 characters. Rotating it invalidates every issued access token, which is the point.
JWT_SIGNING_KEY=

# Given to the seeded operator administrator on first run. At least 12 characters.
ADMIN_PASSWORD=

# Protects the Hangfire dashboard behind basic auth.
JOBS_DASHBOARD_PASSWORD=
