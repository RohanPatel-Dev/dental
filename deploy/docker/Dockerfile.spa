# Both SPAs build identically; APP selects which one. They are static files with a runtime
# config.json, so one image is promoted through every environment and only the mounted config
# changes.
ARG APP=admin

FROM node:22-alpine AS build
ARG APP
WORKDIR /source

COPY clients/${APP}/package.json clients/${APP}/package-lock.json ./
RUN npm ci

COPY clients/${APP}/ ./
RUN npm run build

FROM nginx:1.29-alpine AS final
COPY --from=build /source/dist /usr/share/nginx/html
COPY deploy/docker/spa.nginx.conf /etc/nginx/conf.d/default.conf

# config.json is mounted over at deploy time. The copy baked into the image is the development one
# and must never be cached, or a browser keeps yesterday's API URL.
EXPOSE 8080
