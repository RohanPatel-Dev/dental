{
  "DatabaseOptions": {
    "ConnectionString": "",
    "MigrationsAssembly": "Dental.Notifications.Migrations.PostgreSQL",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3
  },
  "CachingOptions": {
    "Redis": "",
    "InstanceName": "dental:"
  },
  "JwtOptions": {
    "SigningKey": "",
    "Issuer": "dental",
    "Audience": "dental"
  },
  "EventingOptions": {
    "Provider": "RabbitMQ",
    "RabbitMq": "",
    "ExchangeName": "dental.events",
    "OutboxDispatchIntervalSeconds": 10,
    "OutboxBatchSize": 100,
    "ConsumerMaxRetries": 3
  },
  "JobOptions": {
    "ConnectionString": "",
    "DashboardPath": "/jobs",
    "DashboardUser": "admin",
    "DashboardPassword": "",
    "Queues": [ "email", "default" ],
    "RetentionDays": 7
  },
  "MailOptions": {
    "Host": "localhost",
    "Port": 1025,
    "From": "no-reply@dental.local",
    "DisplayName": "Dental",
    "UseStartTls": false,
    "DeliverToLog": true
  },
  "RateLimitingOptions": {
    "Enabled": false
  },
  "NotificationOptions": {
    "ReminderLeadHours": 24,
    "MaxAttempts": 3,
    "BatchSize": 50,
    "DispatchCron": "*/15 * * * *",
    "PracticeName": "Your dental practice"
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" }
  },
  "AllowedHosts": "*"
}
