{
  "DatabaseOptions": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "ObservabilityOptions": {
    "EnableOpenTelemetry": true
  },
  "MailOptions": {
    "DeliverToLog": false,
    "UseStartTls": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Dental": "Information"
      }
    }
  }
}
